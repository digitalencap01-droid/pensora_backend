OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

APP_NAME=Pensora Backend
APP_ENV=development
DEBUG=true
API_BASE_URL=http://127.0.0.1:8000
DB_SCHEMA=ai_blog
DEFAULT_SITE_NAME=Pensora
DEFAULT_SITE_URL=https://example.com
DEFAULT_AUTHOR_NAME=Editorial Team

# Authentication is disabled for now — every endpoint is open. Do not
# deploy this behind a public URL until auth is reintroduced.

SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_MIGRATION_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
# Used only to build public storage URLs for uploaded documents/images.
SUPABASE_URL=https://your-project-ref.supabase.co
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Project Settings -> API -> service_role key (secret). Required for the
# document upload feature (Storage uploads). Leave blank to disable it.
SUPABASE_SERVICE_ROLE_KEY=
DOCUMENT_STORAGE_BUCKET=documents
DOCUMENT_MAX_FILE_SIZE_MB=20

GENERATE_RATE_LIMIT_COUNT=5
GENERATE_RATE_LIMIT_WINDOW_SECONDS=3600

# Optional. Leave blank to disable error monitoring.
SENTRY_DSN=

# LinkedIn publishing. Leave any of these blank to disable the feature.
# Since there's no per-user auth, only one LinkedIn account can be
# connected at a time (whichever was connected most recently).
# LINKEDIN_REDIRECT_URI must exactly match an "Authorized redirect URL"
# configured on the LinkedIn app. For single-machine local dev, a stable
# localhost callback is simpler than a temporary tunnel:
# http://localhost:8000/linkedin/callback
# If you do use ngrok or another tunnel, register that exact callback URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Any random string — signs the OAuth state param.
LINKEDIN_STATE_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LINKEDIN_TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5173

# Webflow publishing. Leave blank to disable the feature. This is a
# single site-level API token (Webflow site settings -> Apps & integrations
# -> Data API / generate an API token), shared globally by this app —
# which site, CMS collection, and field mapping to publish into is
# configured at runtime (POST /api/v1/webflow/connect).
WEBFLOW_TOKEN=
